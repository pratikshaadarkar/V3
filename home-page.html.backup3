<section id="process" style="background:#fff;padding:6rem 2rem">
  <div style="max-width:1100px;margin:0 auto">
    <h2 class="sh fi" style="text-align:center;color:var(--navy)">How We Source and Export Pharmaceuticals</h2>

    <div style="position:relative">
      <!-- Centre line -->
      <div style="position:absolute;left:50%;top:0;bottom:0;width:2px;background:#e2e8f0;transform:translateX(-50%)">
        <div id="hws-line-fill" style="position:absolute;top:0;left:0;width:100%;height:0;background:var(--teal)"></div>
      </div>

      <!-- Step 1 — icon left, text right -->
      <div class="hws-row">
        <div class="hws-icon-side">
          <div class="hws-icon-box">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
        </div>
        <div class="hws-num-col"><div class="hws-dot">1</div></div>
        <div class="hws-text-side">
          <h3 class="hws-title">Understanding Your Requirements</h3>
          <p class="hws-desc">We begin by understanding your specific product requirements, including formulation, strength, dosage form, packaging specifications, quantity, and destination country regulations. The more precisely we understand your requirement upfront, the more accurate and complete our quotation will be.</p>
        </div>
      </div>

      <!-- Step 2 — text left, icon right -->
      <div class="hws-row hws-flip">
        <div class="hws-text-side">
          <h3 class="hws-title">Sourcing from Qualified Manufacturing Partners</h3>
          <p class="hws-desc">Based on your requirements, we source products from carefully selected pharmaceutical manufacturers that hold valid manufacturing licences and comply with applicable quality and regulatory standards. All partners are selected based on their product-specific capabilities and export experience.</p>
        </div>
        <div class="hws-num-col"><div class="hws-dot">2</div></div>
        <div class="hws-icon-side">
          <div class="hws-icon-box">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/><path d="M15.54 8.46a5 5 0 010 7.07M8.46 8.46a5 5 0 000 7.07"/></svg>
          </div>
        </div>
      </div>

      <!-- Step 3 — icon left, text right -->
      <div class="hws-row">
        <div class="hws-icon-side">
          <div class="hws-icon-box">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
        </div>
        <div class="hws-num-col"><div class="hws-dot">3</div></div>
        <div class="hws-text-side">
          <h3 class="hws-title">Manufacturer & Documentation Verification</h3>
          <p class="hws-desc">Before procurement is confirmed, our team verifies the selected manufacturer's credentials: manufacturing licences, GMP certifications, product registrations, quality assurance systems, and production capabilities. We also review all required quality documents including Certificate of Analysis, GMP Certificate, Product Specifications, and Stability Data where required by your importing country. You receive written confirmation before production begins.</p>
        </div>
      </div>

      <!-- Step 4 — text left, icon right -->
      <div class="hws-row hws-flip">
        <div class="hws-text-side">
          <h3 class="hws-title">Procurement & Quality Review</h3>
          <p class="hws-desc">Once your order is confirmed, we procure the required products from approved manufacturing partners under mutually agreed commercial terms. Before dispatch, products undergo quality verification through manufacturer-provided quality documentation and, where required, independent inspection to ensure consistency and compliance with your specifications and applicable regulatory standards.</p>
        </div>
        <div class="hws-num-col"><div class="hws-dot">4</div></div>
        <div class="hws-icon-side">
          <div class="hws-icon-box">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
        </div>
      </div>

      <!-- Step 5 — icon left, text right -->
      <div class="hws-row">
        <div class="hws-icon-side">
          <div class="hws-icon-box">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
          </div>
        </div>
        <div class="hws-num-col"><div class="hws-dot">5</div></div>
        <div class="hws-text-side">
          <h3 class="hws-title">Export Documentation Preparation</h3>
          <p class="hws-desc">We coordinate and prepare all necessary export documentation required for your destination country: Commercial Invoice, Packing List, Certificate of Origin, Bill of Lading or Airway Bill, Certificate of Analysis, COPP, Free Sale Certificate, and any country-specific compliance documents. Every document is reviewed against your importing country's requirements before shipment is released.</p>
        </div>
      </div>

      <!-- Step 6 — text left, icon right -->
      <div class="hws-row hws-flip" style="margin-bottom:0">
        <div class="hws-text-side">
          <h3 class="hws-title">Logistics, Delivery & Post-Shipment Support</h3>
          <p class="hws-desc">We work with reliable logistics partners to arrange transportation, customs clearance, and shipment of pharmaceutical products to international destinations, maintaining product integrity throughout the supply chain. Our team provides shipment tracking, documentation support, and post-shipment assistance for a smooth delivery process and ongoing procurement requirements.</p>
        </div>
        <div class="hws-num-col"><div class="hws-dot">6</div></div>
        <div class="hws-icon-side">
          <div class="hws-icon-box">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .hws-row{display:flex;align-items:center;gap:0;margin-bottom:2rem;position:relative}
    .hws-icon-side{flex:1;display:flex;justify-content:flex-end;padding-right:3rem}
    .hws-flip .hws-icon-side{justify-content:flex-start;padding-right:0;padding-left:3rem}
    .hws-text-side{flex:1;padding-left:3rem}
    .hws-flip .hws-text-side{padding-left:0;padding-right:3rem;text-align:right}
    .hws-num-col{flex:0 0 0;display:flex;justify-content:center;position:relative;z-index:1}
    .hws-dot{width:44px;height:44px;border-radius:50%;background:var(--teal);color:#fff;font-weight:700;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 0 0 6px #fff,0 0 0 8px #e2e8f0}
    .hws-icon-box{width:120px;height:120px;border-radius:16px;background:#f0fdfa;border:1.5px solid #ccfbf1;display:flex;align-items:center;justify-content:center}
    .hws-title{font-family:var(--hf);font-size:1.15rem;font-weight:700;color:var(--navy);margin:0 0 .75rem 0}
    .hws-desc{font-size:0.9rem;color:var(--mgrey);line-height:1.75;margin:0}
  </style>
  <script>
  (function(){
    var fill    = document.getElementById('hws-line-fill');
    var section = document.getElementById('process');
    if(!fill || !section) return;
    var dots     = section.querySelectorAll('.hws-dot');
    var firstDot = dots[0];
    var lastDot  = dots[dots.length - 1];
    var fillCont = fill.parentElement;
    var rafId    = null;
    var active   = false;
    var currentH = 0;
    function setLine(){
      var viewCenter  = window.innerHeight * 0.5;
      var contTop     = fillCont.getBoundingClientRect().top;
      var firstCenter = firstDot.getBoundingClientRect().top + firstDot.offsetHeight / 2;
      var lastCenter  = lastDot.getBoundingClientRect().top  + lastDot.offsetHeight  / 2;
      var range       = lastCenter - firstCenter;
      var progress    = range !== 0 ? Math.max(0, Math.min(1, (viewCenter - firstCenter) / range)) : 0;
      var topPx       = firstCenter - contTop;
      var totalH      = lastCenter  - firstCenter;
      var targetH     = Math.max(0, progress * totalH);
      currentH += (targetH - currentH) * 0.08;
      fill.style.top    = topPx + 'px';
      fill.style.height = currentH + 'px';
      rafId = null;
      if(active) rafId = requestAnimationFrame(setLine);
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        active = e.isIntersecting;
        if(active && !rafId) rafId = requestAnimationFrame(setLine);
        else if(!active && rafId){ cancelAnimationFrame(rafId); rafId = null; }
      });
    },{threshold:0});
    io.observe(section);
    window.addEventListener('scroll',function(){
      if(active && !rafId) rafId = requestAnimationFrame(setLine);
    },{passive:true});
  })();
  </script>
</section>


