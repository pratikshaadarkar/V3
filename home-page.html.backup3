<section id="regulatory" style="padding:6rem 2rem;background:#fff;margin-left:-6rem">
  <div style="max-width:1200px;margin:0 auto">

    <h2 class="sh" style="text-align:left;margin-bottom:2.5rem">About V3 LifeCare Exim</h2>

    <div style="display:flex;gap:3rem;align-items:flex-start;width:100%">

      <!-- Left: Image -->
      <div style="flex:1.4;min-width:0">
        <img src="ChatGPT%20Image%20Jul%2016%2C%202026%2C%2010_44_55%20PM.png" style="width:100%;aspect-ratio:4/3;display:block;object-fit:cover" alt="About V3 Life Care Exim"/>
      </div>

      <!-- Right: Content -->
      <div style="flex:1.7;min-width:0">
        <p class="bt" style="font-size:1rem">V3 Life Care Exim is a pharmaceutical merchant exporter specialising in sourcing, regulatory documentation, and export coordination for global markets. Every product inquiry is supported by a carefully selected WHO-GMP certified manufacturing network and an experienced in-house regulatory team, helping buyers make informed sourcing decisions with complete documentation support.</p>

        <p class="bt" style="font-weight:700;margin-top:1.5rem;margin-bottom:0;font-size:1.1rem">What You Can Expect:</p>
        <ul style="list-style:none;padding:0;margin:.25rem 0 0 0">
          <li style="font-size:1rem;color:var(--dgrey);line-height:1.8;padding:0.2rem 0;display:flex;align-items:flex-start;gap:0.8rem"><span style="flex-shrink:0;margin-top:2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L4 6v6c0 5.25 3.5 10.15 8 11.35C16.5 22.15 20 17.25 20 12V6L12 2z" fill="var(--teal)"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></span><span>Products sourced through qualified WHO-GMP certified manufacturing partners</span></li>
          <li style="font-size:1rem;color:var(--dgrey);line-height:1.8;padding:0.2rem 0;display:flex;align-items:flex-start;gap:0.8rem"><span style="flex-shrink:0;margin-top:2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L4 6v6c0 5.25 3.5 10.15 8 11.35C16.5 22.15 20 17.25 20 12V6L12 2z" fill="var(--teal)"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></span><span>In-house regulatory documentation support</span></li>
          <li style="font-size:1rem;color:var(--dgrey);line-height:1.8;padding:0.2rem 0;display:flex;align-items:flex-start;gap:0.8rem"><span style="flex-shrink:0;margin-top:2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L4 6v6c0 5.25 3.5 10.15 8 11.35C16.5 22.15 20 17.25 20 12V6L12 2z" fill="var(--teal)"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></span><span>Professional export coordination</span></li>
          <li style="font-size:1rem;color:var(--dgrey);line-height:1.8;padding:0.2rem 0;display:flex;align-items:flex-start;gap:0.8rem"><span style="flex-shrink:0;margin-top:2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L4 6v6c0 5.25 3.5 10.15 8 11.35C16.5 22.15 20 17.25 20 12V6L12 2z" fill="var(--teal)"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></span><span>Clear communication from inquiry to shipment</span></li>
        </ul>
        <a href="#why-v3" class="readmore-btn" style="margin-top:.75rem;display:inline-flex;align-items:center;gap:.4rem;color:var(--teal);font-size:1rem;font-weight:600;text-decoration:none;border:none;background:none;transition:color .2s ease">Read More <svg class="readmore-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="transition:transform .2s ease"><path d="M9 18l6-6-6-6"/></svg></a>
<style>.readmore-btn:hover{color:var(--navy)!important}.readmore-btn:hover .readmore-arrow{transform:translateX(4px)}</style>
      </div>

    </div>
  </div>
</section>

