            <svg width="20" height="20" viewBox="0 0 24 24" fill="#FF6B35"><path d="M12 1L4 5V12C4 18 12 22 12 22S20 18 20 12V5L12 1Z" fill="#FF6B35"/><polyline points="9 12 11 14 15 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
